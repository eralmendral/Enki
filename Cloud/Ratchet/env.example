# ==================================
# AWS Configuration
# ==================================
AWS_PROFILE=ratchet
AWS_REGION=us-east-1

# ==================================
# Amazon Bedrock Configuration
# ==================================
# Claude model for code generation (claude-3-5-sonnet recommended)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Titan model for text embeddings
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ==================================
# Local Development Settings
# ==================================
# ChromaDB URL (local Docker container)
CHROMA_URL=http://localhost:8000

# Backend API port
API_PORT=8080

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:4200

# ==================================
# Feature Flags
# ==================================
# Set to true to use local ChromaDB, false to use AWS OpenSearch
USE_LOCAL_VECTORDB=true

# Enable debug logging
DEBUG=false

# ==================================
# Optional: External Services
# ==================================
# Only needed if using external embedding services instead of Bedrock
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# ==================================
# USAGE: Copy this file to .env
# ==================================
# cp env.example .env

